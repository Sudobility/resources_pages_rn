{
  "name": "@sudobility/resources_pages_rn",
  "version": "0.0.1",
  "description": "React Native UI components for the Sudobility resources catalog (tile list of language-specific helper links)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --ignore-pattern dist --ignore-pattern node_modules --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --ignore-pattern dist --ignore-pattern node_modules --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test:unit": "vitest run",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "@sudobility/resources_client": "^0.0.1",
    "@sudobility/design": "^1.1.71",
    "@sudobility/types": "^1.9.79"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/resources_client": "^0.0.1",
    "@sudobility/design": "^1.1.71",
    "@sudobility/types": "^1.9.79",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "jsdom": "~30.1.3",
    "nativewind": "~4.2.7",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-native": "~0.83.10",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/resources_pages_rn.git"
  }
}
